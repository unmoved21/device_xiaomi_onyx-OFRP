# Gatekeeper, Encryption
fbe.metadata.wrappedkey=true
vendor.gatekeeper.disable_spu=true

# Platform
ro.board.platform=sun

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Dynamic Partitions
ro.boot.dynamic_partitions=true

# Charger suspend 
ro.charger.enable_suspend=1

# ADB
ro.adb.secure=0

# Vibrator
ro.odm.mm.vibrator.device_type=ff
ro.odm.mm.vibrator.resonant_frequency=170
ro.odm.mm.vibrator.si_sys_path=/sys/bus/i2c/drivers/sih_haptic_688X/5-006b
ro.odm.mm.vibrator.slide_effect_protect_time=20
